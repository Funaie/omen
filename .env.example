# Kopiér denne fil til ".env" og udfyld med rigtige værdier.
# .env er i .gitignore og bliver aldrig committet.
#
# Nøglerne hentes her (log ind med din WarcraftLogs-konto):
#   https://www.warcraftlogs.com/api/clients/
# Opret en client — navn fx "Omen landingpage", redirect URL må gerne
# være http://localhost (bruges ikke ved client credentials).

WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
